{"architecture":{"component_kinds":[{"id":"prism.arch@1.0.0::ComponentKind.cliAdapter","index":0},{"id":"prism.arch@1.0.0::ComponentKind.database","index":1},{"id":"prism.arch@1.0.0::ComponentKind.externalSystem","index":2},{"id":"prism.arch@1.0.0::ComponentKind.releaseBinary","index":3},{"id":"prism.arch@1.0.0::ComponentKind.service","index":4},{"id":"prism.arch@1.0.0::ComponentKind.staticSite","index":5}],"components":[{"id":"Architecture::component00UnitSynthesisCompiler","index":0,"kind_id":"prism.arch@1.0.0::ComponentKind.service","name":"3D Unit Synthesis & Hardpoint Socket Compiler (UnitSynthesis.lex.tex)","text":"Compiles [Doctrine (6), Chassis (5), Echelon (5)] into 150 deterministic unit archetypes while enforcing the 6-Berth cap, 16-Alloy starting charter, and Zero-Stat-Inflation law."},{"id":"Architecture::component01StrikePoolResolver","index":1,"kind_id":"prism.arch@1.0.0::ComponentKind.service","name":"Unified d6 Strike Pool, Cover & Mitigation Resolver (CombatEngine.lex.tex)","text":"Resolves opposed FPR vs EVA d6 pools (4+ = 1 Hit), 4-sector Momentum Charge bonuses, Barricade/Bulkhead cover, Plating (ARM), Bio-Resilience (TGH), and Fireteam spillover."},{"id":"Architecture::component02CommandChitDirector","index":2,"kind_id":"prism.arch@1.0.0::ComponentKind.service","name":"Opaque Command Chit Pool & Autonomous Warden AI Director (NemesisChit.lex.tex)","text":"Executes the 5-round activation loop, returning Warden Directive Chit, 1d6 wrap-around berth selector, Multi-Berth Boss scaling, and 6 deterministic Doctrine AI routines."},{"id":"Architecture::component03ResonanceWeaveEngine","index":3,"kind_id":"prism.arch@1.0.0::ComponentKind.service","name":"6-Frequency Resonance Weave & Masterwork Hardpoint Engine (ResonanceWeave.lex.tex)","text":"Governs 16 Hardpoint Modules (1-slot 3 Alloy & 2-slot Masterwork 6 Alloy), 6 Resonance Frequencies, Minor/Major Harmonics, and 1d6 Resonance Overheat Backlash."},{"id":"Architecture::component04OrbitalBastionLedger","index":4,"kind_id":"prism.arch@1.0.0::ComponentKind.database","name":"Orbital Bastion Campaign Hub & Canonical Save Ledger (CampaignBastion.lex.tex)","text":"Manages the 4 Pre-Drop Crew Assignments, Push Roll risk, 3 Bastion Facilities, 6 Core Sector Contracts, and deterministic save-state receipts."},{"id":"Architecture::component05CoreWasmArithmeticGuest","index":5,"kind_id":"prism.arch@1.0.0::ComponentKind.releaseBinary","name":"Import-Free Core-Wasm Guest & HOLOVIEW Surface (Contract.lex.tex, Presentation.lex.tex)","text":"Executes hologram:guest/core-wasm@1 deterministic integer arithmetic (holo_run, 52B req / 27B resp) and renders the WCAG 2.2 AA certified Karst tactical viewport."}],"concerns":[{"id":"Architecture::concern00ZeroStatInflationBalance","index":0,"name":"Zero-Stat-Inflation Progression & Horizontal Hardpoint Modularity","text":"Guarantees that base FPR, EVA, and COG dice pools never inflate from XP; campaign advancement strictly unlocks horizontal Hardpoint Sockets (3 XP = +1 Socket)."},{"id":"Architecture::concern01DeterministicStrikeCombat","index":1,"name":"Unified d6 Strike Resolution, Cover Geometry & Fireteam Spillover","text":"Enforces exact integer Net Hits, 4-sector Momentum Charge bonuses, Barricade/Bulkhead cover rules, Plating/Resilience mitigation, and Fireteam casualty division."},{"id":"Architecture::concern02AutonomousWardenChitAi","index":2,"name":"Opaque Command Chit Pacing & Deterministic Warden AI Routines","text":"Guarantees unpredictable interleaved turn pacing via a returning Warden Directive Chit, 1d6 wrap-around berth selection, and 6 Doctrine AI routines."},{"id":"Architecture::concern03ResonanceHarmonicWeaving","index":3,"name":"6-Frequency Resonance Harmonics & Masterwork Hardpoint Economy","text":"Balances 1-slot (3 Alloy) and 2-slot Masterwork (6 Alloy) modules across 6 Resonance Frequencies with Minor/Major Harmonics and 1d6 Overheat Backlash."},{"id":"Architecture::concern04CoreWasmSandboxIsolation","index":4,"name":"Import-Free Core-Wasm Guest Isolation & Bounded Wire Protocol","text":"Requires zero Wasm host imports, bounded 52B request / 27B response frames, 64 KiB guest allocation ceiling, and 34 verified acceptance vectors."},{"id":"Architecture::concern05WcagTacticalErgonomics","index":5,"name":"WCAG 2.2 AA Tactical Readability & 5-Pole Stakeholder Vantages","text":"Proves >= 4.5:1 integer sRGB contrast across dark and light tactical palettes and provides a 5-pole progressive walkthrough for all 4 stakeholders."}],"edge_kinds":[{"id":"prism.arch@1.0.0::EdgeKind.controlFlow","index":0},{"id":"prism.arch@1.0.0::EdgeKind.dataFlow","index":1}],"edges":[{"from_index":0,"id":"Architecture::edge00SynthesisToBastion","index":0,"kind_id":"prism.arch@1.0.0::EdgeKind.dataFlow","to_index":4},{"from_index":4,"id":"Architecture::edge01BastionToChitDirector","index":1,"kind_id":"prism.arch@1.0.0::EdgeKind.controlFlow","to_index":2},{"from_index":2,"id":"Architecture::edge02ChitDirectorToCombat","index":2,"kind_id":"prism.arch@1.0.0::EdgeKind.controlFlow","to_index":1},{"from_index":3,"id":"Architecture::edge03ResonanceToSynthesis","index":3,"kind_id":"prism.arch@1.0.0::EdgeKind.dataFlow","to_index":0},{"from_index":3,"id":"Architecture::edge04ResonanceToCombat","index":4,"kind_id":"prism.arch@1.0.0::EdgeKind.dataFlow","to_index":1},{"from_index":1,"id":"Architecture::edge05CombatToCoreWasm","index":5,"kind_id":"prism.arch@1.0.0::EdgeKind.dataFlow","to_index":5},{"from_index":0,"id":"Architecture::edge06SynthesisToCoreWasm","index":6,"kind_id":"prism.arch@1.0.0::EdgeKind.dataFlow","to_index":5},{"from_index":1,"id":"Architecture::edge07CombatToBastion","index":7,"kind_id":"prism.arch@1.0.0::EdgeKind.dataFlow","to_index":4}],"model_kinds":[{"id":"prism.arch@1.0.0::ModelKind.componentModel","index":0},{"id":"prism.arch@1.0.0::ModelKind.qualityModel","index":1},{"id":"prism.arch@1.0.0::ModelKind.securityModel","index":2}],"stakeholders":[{"id":"Architecture::stakeholder00TacticalCom